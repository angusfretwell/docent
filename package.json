{
  "name": "docent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:worker && ./scripts/dev.ts",
    "build": "bun run --sequential build:worker build:docent",
    "build:docent": "bun build --compile --production --outfile dist/docent src/docent.ts",
    "build:worker": "./scripts/bundle-worker.ts",
    "prepare": "bun run --parallel prepare:*",
    "prepare:effect": "./scripts/prepare-effect.sh",
    "prepare:fixture": "./scripts/prepare-fixture.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel --dots",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "preflight": "bun run --parallel check typecheck test build"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-beta.97",
    "date-fns": "^4.4.0",
    "effect": "^4.0.0-beta.97",
    "open": "^11.0.0",
    "radashi": "^12.9.1",
    "rrweb": "^2.1.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.6",
    "@pierre/diffs": "1.2.12",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "ultracite": "7.9.3"
  }
}
