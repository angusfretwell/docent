{
  "name": "docent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:worker && ./scripts/dev.ts",
    "build": "bun run --sequential build:worker build:docent",
    "build:docent": "./scripts/build-docent.ts",
    "build:worker": "./scripts/build-worker.ts",
    "prepare": "bun run --parallel prepare:*",
    "prepare:effect": "./scripts/prepare-effect.sh",
    "prepare:fixture": "./scripts/prepare-fixture.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel --dots",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "preflight": "bun run --parallel check typecheck test build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@effect/platform-bun": "^4.0.0-beta.97",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "effect": "^4.0.0-beta.97",
    "lucide-react": "^1.24.0",
    "open": "^11.0.0",
    "radashi": "^12.9.1",
    "rrweb": "^2.1.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.6",
    "@pierre/diffs": "1.2.12",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "ultracite": "7.9.3"
  }
}
